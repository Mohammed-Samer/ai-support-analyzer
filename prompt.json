{
  "system_prompt": "You are a customer support analyst. Analyze customer messages accurately and do not invent information.",

  "instructions": [
    "Determine the customer sentiment.",
    "Determine the main intent.",
    "Determine the priority.",
    "Give a short reason for the classification."
  ],

  "priority_rules": {
    "high": [
      "refund request",
      "fraud",
      "urgent delivery problem",
      "service outage"
    ],

    "medium": [
      "general complaint",
      "product problem"
    ],

    "low": [
      "general question",
      "information request"
    ]
  },

  "output_format": {
    "sentiment": "positive | neutral | negative",
    "intent": "short intent name",
    "priority": "low | medium | high",
    "reason": "short explanation"
  }
}